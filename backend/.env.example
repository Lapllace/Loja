# Banco PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

# Segredo do JWT de autenticação
JWT_SECRET=change-me

# Google OAuth (Login com Google)
# Client ID do painel Google Cloud → APIs e serviços → Credenciais → ID de cliente OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# SuperFrete - cálculo de frete (API v2)
# Token da conta SuperFrete; sem ele o backend responde com o frete fixo por região.
SUPERFRETE_TOKEN=
# Opcional: ambiente da API (default: https://sandbox.superfrete.com/api/v2/calculator)
# SUPERFRETE_API_URL=https://sandbox.superfrete.com/api/v2/calculator
# CEP de origem da expedição (8 dígitos)
SHIPMENT_ORIGIN_ZIPCODE="44091392"

# Meta WhatsApp Cloud API (notificações automáticas de pedido)
# Deixe em branco para desativar — o backend continua funcionando normalmente.
# Phone Number ID encontrado em: Meta Business → WhatsApp → API Setup
META_WA_PHONE_NUMBER_ID=
# Token permanente ou temporário (60 dias) gerado no painel Meta for Developers
META_WA_ACCESS_TOKEN=

# Google reCAPTCHA v3
# Chave secreta do painel Google reCAPTCHA Admin (diferente da site key pública).
# Deixe vazia para desabilitar — o guard deixa todas as requisições passarem.
RECAPTCHA_SECRET_KEY=

# ── URL pública da aplicação (links de retorno/notificação do PagBank) ──
APP_URL=http://localhost:3000

# ── CORS e servidor ──
# Origens extras permitidas além de localhost/127.0.0.1 (separadas por vírgula).
CORS_ORIGIN=
# Porta e host do servidor Nest (HOST=0.0.0.0 permite acesso pela rede local).
PORT=3000
HOST=0.0.0.0

# ── JWT ──
# Tempo de expiração do access token (ex.: 15m, 1h, 7d). Padrão: 1h.
JWT_EXPIRES_IN=1h

# ── PagBank (pagamento online PIX) ──
# Token da API PagBank (sandbox ou produção). Sem ele o checkout PIX é desativado.
PAGBANK_API_TOKEN=
# URL base da API PagBank (padrão: https://sandbox.api.pagseguro.com).
PAGBANK_API_URL=https://sandbox.api.pagseguro.com
# Token de autenticidade dos webhooks PagBank (valida assinatura HMAC-SHA256).
# Sem ele os webhooks são rejeitados.
PAGBANK_WEBHOOK_TOKEN=
# URL de retorno após o checkout (opcional; padrão: APP_URL + /checkout/return).
PAGBANK_CHECKOUT_RETURN_URL=

# ── 99minutos / 99Entrega (entregas) ──
# Integração pronta, porém desativada até haver credenciais e geocodificação
# de endereços (o modelo Address ainda não guarda latitude/longitude).
NINENINE_ENVIRONMENT=sandbox
NINENINE_CLIENT_ID=
NINENINE_CLIENT_SECRET=
NINENINE_WEBHOOK_SECRET=

# ── Uber Direct (entregas) ──
# Integração pronta (stub), desativada até haver credenciais e contrato oficial.
UBER_API_URL=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ACCESS_TOKEN=
UBER_WEBHOOK_SECRET=

# ── Ajustes internos da busca de imagens (opcionais) ──
IMAGE_BOT_MAX_RESULTS=30
IMAGE_BOT_MAX_DOWNLOAD_BYTES=12582912

