# Banco PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

# Segredo do JWT de autenticação
JWT_SECRET=change-me

# Google OAuth (Login com Google)
# Client ID do painel Google Cloud → APIs e serviços → Credenciais → ID de cliente OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# SuperFrete - cálculo de frete (API v2)
# Token da conta SuperFrete; sem ele o backend responde com o frete fixo por região.
SUPERFRETE_TOKEN=
# Opcional: ambiente da API (default: https://sandbox.superfrete.com/api/v2/calculator)
# SUPERFRETE_API_URL=https://sandbox.superfrete.com/api/v2/calculator
# CEP de origem da expedição (8 dígitos)
SHIPMENT_ORIGIN_ZIPCODE="44091392"

# Meta WhatsApp Cloud API (notificações automáticas de pedido)
# Deixe em branco para desativar — o backend continua funcionando normalmente.
# Phone Number ID encontrado em: Meta Business → WhatsApp → API Setup
META_WA_PHONE_NUMBER_ID=
# Token permanente ou temporário (60 dias) gerado no painel Meta for Developers
META_WA_ACCESS_TOKEN=

# Google reCAPTCHA v3
# Chave secreta do painel Google reCAPTCHA Admin (diferente da site key pública).
# Deixe vazia para desabilitar — o guard deixa todas as requisições passarem.
RECAPTCHA_SECRET_KEY=
